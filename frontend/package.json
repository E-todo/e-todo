{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "npx prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html,md}\"",
    "format:check": "npx prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html,md}\"",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "iconoir-react": "^7.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
